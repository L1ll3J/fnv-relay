#!/usr/bin/env python3
"""Launch this checkout's private local relay installation without shell expansion."""
import json
import os
from pathlib import Path
import sys

settings = Path(__file__).resolve().with_name('.relay-launcher.json')
try:
    config = json.loads(settings.read_text())
    executable = Path(config['executable'])
    state = Path(config['state_dir'])
    if not executable.is_absolute() or not executable.is_file() or not state.is_absolute():
        raise ValueError('Invalid local launcher configuration')
except (OSError, ValueError, KeyError, TypeError):
    print('Run scripts/bootstrap-ubuntu.sh first to configure this checkout’s relay installation.', file=sys.stderr)
    sys.exit(1)
try:
    os.execv(str(executable), [str(executable), '--state-dir', str(state), *sys.argv[1:]])
except OSError:
    print('The local relay executable is unavailable. Re-run bootstrap to repair this installation.', file=sys.stderr)
    sys.exit(1)
